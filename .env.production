# URLs
FRONTEND_URL=https://maithil-vivah.netlify.app
BACKEND_URL=https://api.growwzy.com

# Security
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
