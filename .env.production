NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://maithil-vivah.netlify.app

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=MaithilDB@2026!Secure
DB_NAME=maithilvivah
DB_SYNC=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=maithilvivah

# JWT Secrets (CHANGE THESE IN PRODUCTION)
JWT_SECRET=maithilvivah-jwt-secret-key-2026-change-this-to-something-more-secure-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=maithilvivah-refresh-token-secret-2026-change-this-to-something-more-secure-in-production
JWT_REFRESH_EXPIRATION=30d

# Email Service (Placeholder - Add SendGrid credentials later)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@maithilvivah.com
SENDGRID_FROM_NAME=Maithil Vivah

# SMS Service (Placeholder - SMS disabled for now)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
